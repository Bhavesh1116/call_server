{
  "name": "webrtc-group-call",
  "version": "1.1.0",
  "description": "Advanced group video call application using WebRTC and Mediasoup with scalable architecture, enhanced security, and production-ready infrastructure",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "validate": "npm run lint && npm run format:check && npm run test",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "prestart": "npm run validate",
    "prebuild": "npm run lint && npm run test"
  },
  "keywords": [
    "webrtc",
    "mediasoup",
    "group-call",
    "video-conference",
    "socket.io",
    "real-time",
    "nodejs",
    "express",
    "secure",
    "scalable"
  ],
  "author": "Bhavesh1116",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mediasoup": "^3.11.5",
    "socket.io": "^4.7.2",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.0",
    "pino": "^8.17.2",
    "pino-http": "^8.7.0",
    "express-request-id": "^1.4.1",
    "compression": "^1.7.4",
    "connect-timeout": "^1.9.0",
    "xss": "^1.0.14",
    "ioredis": "^5.3.2",
    "rate-limit-redis": "^4.1.5",
    "libphonenumber-js": "^1.10.47",
    "mongoose": "^8.0.0",
    "uuid": "^9.0.1",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "jest-extended": "^4.0.2",
    "morgan": "^1.10.0",
    "cross-env": "^7.0.3",
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bhavesh1116/call_server.git"
  },
  "bugs": {
    "url": "https://github.com/Bhavesh1116/call_server/issues"
  },
  "homepage": "https://github.com/Bhavesh1116/call_server#readme",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!dist/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "setupFilesAfterEnv": [
      "jest-extended/all"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 2
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": "latest"
    },
    "rules": {
      "no-console": [
        "warn",
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ],
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  }
}
